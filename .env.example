# Copy to .env and fill in. .env is gitignored; this file is the
# public documentation of what config the project needs.

# myACLED account credentials (OAuth password grant)
ACLED_EMAIL=you@example.com
ACLED_PASSWORD=your-myacled-password

# Postgres (must match docker-compose.yml)
POSTGRES_USER=pi_analyst
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pi_platform
PGHOST=localhost
PGPORT=5432
